# WebSocket DDP del servidor Meteor (en producción normalmente wss://dominio/websocket)
VITE_METEOR_DDP_URL=ws://localhost:3000/websocket
# Base HTTP para enlaces de imágenes servidos por Meteor
VITE_METEOR_HTTP_URL=http://localhost:3000
# _id del usuario propietario (TiendasComercio.idUser) o, como alternativa,
# _id de una tienda de la empresa (se resuelve su propietario vía DDP).
VITE_COMERCIO_EMPRESA_ID=
# Opcional: nombre de marca si se quiere reemplazar el nombre de la tienda principal
VITE_COMERCIO_NOMBRE=
# Clave pública de Google Maps Platform, restringida por origen HTTP y APIs
VITE_GOOGLE_MAPS_API_KEY=
